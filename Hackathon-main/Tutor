const QUIZ = [
  'Quiz time: which port does HTTPS normally use, and which tool from this lab would you use to discover it is open?',
  'Quiz time: what does `chmod 600 secrets.env` change, and why is it a good idea?',
  'Quiz time: why should passwords be stored with bcrypt or Argon2 instead of plain SHA-256?',
  'Quiz time: in a packet capture you see many SYN packets from one IP and no ACKs. What might be happening?'
];

function offlineAnswer(message, context) {
  const text = String(message || '').toLowerCase();
  const ctx = context || {};

  if (/quiz|test me/.test(text)) return QUIZ[Math.floor(Math.random() * QUIZ.length)];

  let haystack = text;
  if (/last command|my command|that command|previous|my output|that output|what did i/.test(text)) {
    const last = (ctx.recentCommands || []).slice(-1)[0];
    if (last) haystack += ' ' + last.toLowerCase();
  }

  // Match on whole words/phrases to avoid "ls" matching "tools".
  const hit = KB.find(entry =>
    entry.keys.some(k => new RegExp('(^|[^a-z0-9])' + k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '([^a-z0-9]|$)').test(haystack))
  );
  if (hit) return hit.text;

  if (/next|what should|stuck|hint|help/.test(text)) {
    const objectives = (ctx.objectives || []).slice(0, 3).join('; ');
    return "Here is a good way to move forward: read the mission objectives" +
      (objectives ? ' (' + objectives + ')' : '') +
      ", then run `ls` to see what is around and `cat mission.txt` to read the goal. Type `hint` in the terminal for a mission hint, or ask me about any command like `nmap`, `grep` or `chmod`.";
  }

  return "I can explain Kali tools and Linux commands. Try asking about nmap, wireshark, gobuster, sqlmap, hashing, permissions, grep or logs. Or say \"quiz me\".\n(Offline tutor mode: the AI tutor is not configured on this server.)";
}

